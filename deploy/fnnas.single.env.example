# 飞牛 NAS 单镜像示例环境变量
# 配合 docker-compose.single.yml 使用

GIP_IMAGE_NAME=gpt-image-playground
GIP_IMAGE_TAG=1.6.3
# 仅在叠加 docker-compose.single.build.yml 做源码构建时使用
GIP_IMAGE_BUILD_VERSION=1.6.3
GIP_IMAGE_BUILD_VCS_REF=local
GIP_IMAGE_BUILD_DATE=unknown
GIP_HTTP_PORT=8080
# 默认要求 HTTPS（推荐）。如果你的部署仅通过 HTTP 暴露（仅限局域网 NAS）才改成 false，
# 否则浏览器在 HTTPS 站点上不会回传 cookie，导致登录态丢失。
GIP_SESSION_SECURE=false
OPENAI_BASE_URL=https://api.openai.com/v1
GIP_REQUEST_TIMEOUT_SECONDS=300
GIP_GENERATION_WORKER_COUNT=4
GIP_SESSION_TTL_SECONDS=604800
GIP_MAX_UPLOAD_BYTES=26214400
GIP_THUMBNAIL_MAX_SIZE=512
GIP_RESTORE_POINT_RETENTION=10
GIP_STARTUP_BACKUP_ENABLED=true
GIP_STARTUP_BACKUP_RETENTION=5
GIP_CORS_ORIGINS=http://你的飞牛IP:8080
